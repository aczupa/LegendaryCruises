@page "/polynesie"
@using LegendaryCruises.Components
@using LegendaryCruises.Interfaces
@inject IJSRuntime JS

@{
    string baseUrl = "https://worldcruises.blob.core.windows.net/videos/";

    string[] videos = new[]
    {
        $"{baseUrl}Polynesie7.mp4",
        $"{baseUrl}Polynesie1.mp4",
        $"{baseUrl}tahiti.mp4",
        $"{baseUrl}Polynesie3.mp4",
        $"{baseUrl}Polynesie4.mp4",
        $"{baseUrl}polynesie8.mp4",
        $"{baseUrl}Polynesie6.mp4",
        $"{baseUrl}Polynesie2.mp4",
        $"{baseUrl}Polynesie5.mp4",
        $"{baseUrl}Polynesie9.mp4"
    };
}

<div class="page">

    <div class="top-bar">
        <NavLink class="home-link" href="" Match="NavLinkMatch.All">
            <span class="oi oi-home" aria-hidden="true"></span>
        </NavLink>

        <h1 class="title">Polynésie Française</h1>
        <ButtonBuy Slug="@cruiseSlug" />
    </div>

    <div class="accordion-grid">
        @for (int i = 0; i < videos.Length; i++)
        {
            <div class="cell">
                <video src="@videos[i]"
                       autoplay
                       muted
                       loop
                       playsinline>
                </video>
            </div>
        }
    </div>
</div>

<div id="overlay" class="overlay" onclick="closeOverlay()">
    <div class="overlay-content" onclick="event.stopPropagation()">
        <button class="close-btn" onclick="closeOverlay()">×</button>
        <div id="overlay-text"></div>
    </div>
</div>

@code {
    [Inject] ICruiseService CruiseService { get; set; }

    private string cruiseSlug = "";

    protected override async Task OnInitializedAsync()
    {
        var cruise = await CruiseService.GetCruiseByName("Polynésie");

        if (cruise != null)
            cruiseSlug = cruise.Slug;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initPolynesieOverlay");
        }
    }
}
