@page "/nil"
@using LegendaryCruises.Components
@using LegendaryCruises.Interfaces
@using LegendaryCruises.Models
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<Nil> Logger

<nav class="navbar navbar-expand-md navbar-light px-1">

    <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="https://worldcruises.blob.core.windows.net/images/logo-world-cruises.png"
             alt="World Cruises Logo" style="height:70px;" />
    </a>

    <h3 class="ms-3">Le Nil</h3>

    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse"
            data-bs-target="#mainNavbar">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
        <div class="d-flex flex-column flex-md-row gap-3 align-items-center">

            <AuthorizeView Roles="Admin, Recruiter">
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/cruises-table">CRUISES</a>
                </div>
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/add-cruise">ADD CRUISE</a>
                </div>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized Context="authState">
                    <span class="me-2 login2">
                        Bonjour @(authState.User.Identity?.Name ?? authState.User.FindFirst(ClaimTypes.Email)?.Value)
                    </span>

                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Logout">LOGOUT</a>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <div class="nav-item px-1">
                        <a class="btn login"
                           href="/Identity/Account/Login?returnUrl=/@Nav.ToBaseRelativePath(Nav.Uri)">
                            LOGIN
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            <ButtonBuy Slug="@cruiseSlug" IsLoading="@isLoadingSlug" />

        </div>
    </div>
</nav>
<!-- ===== SECTION 1 ===== -->

<section class="nil-section">

    <div class="nil-section-content">

        <!-- PROGRAM -->

        <div class="nil-program nil-program-luxury">

            <div class="nil-section-header">

                <div class="nil-header-icon">
                    <i class="bi bi-compass"></i>
                </div>

                <div>
                    <span class="nil-subtitle">
                        CROISIÈRE D'EXCEPTION
                    </span>

                    <h2>
                        Croisière sur le Nil
                    </h2>

                    <p>
                        6 jours à travers les trésors de l'Égypte ancienne
                    </p>
                </div>

            </div>


            <div class="nil-itinerary-grid">


                <!-- JOUR 1 -->

                <div class="nil-day-card">

                    <div class="nil-day-number">

                        <span>JOUR</span>

                        <strong>1</strong>

                    </div>


                    <div class="nil-day-content">

                        <h3>
                            <i class="bi bi-geo-alt-fill"></i>
                            Louxor
                        </h3>

                        <p>
                            <strong>Temple de Karnak :</strong>
                            Immense complexe dédié à Amon, célèbre pour sa
                            salle hypostyle et ses obélisques.
                        </p>

                        <p>
                            <strong>Temple de Louxor :</strong>
                            Temple élégant en plein cœur de la ville,
                            particulièrement magique au coucher du soleil.
                        </p>

                    </div>

                </div>


                <!-- JOUR 2 -->

                <div class="nil-day-card">

                    <div class="nil-day-number">

                        <span>JOUR</span>

                        <strong>2</strong>

                    </div>


                    <div class="nil-day-content">

                        <h3>
                            <i class="bi bi-geo-alt-fill"></i>
                            Louxor → Edfou
                        </h3>

                        <p>
                            <strong>Vallée des Rois :</strong>
                            Tombes des pharaons du Nouvel Empire,
                            décorées de scènes mythologiques.
                        </p>

                        <p>
                            <strong>Hatchepsout et Colosses de Memnon.</strong>
                        </p>

                    </div>

                </div>


                <!-- JOUR 3 -->

                <div class="nil-day-card">

                    <div class="nil-day-number">

                        <span>JOUR</span>

                        <strong>3</strong>

                    </div>


                    <div class="nil-day-content">

                        <h3>
                            <i class="bi bi-geo-alt-fill"></i>
                            Edfou → Kom Ombo
                        </h3>

                        <p>
                            <strong>Temple d'Horus :</strong>
                            L'un des temples les mieux conservés,
                            dédié au dieu faucon.
                        </p>

                        <p>
                            <strong>Temple de Kom Ombo :</strong>
                            Temple double consacré à Sobek et Horus,
                            avec un petit musée de crocodiles momifiés.
                        </p>

                    </div>

                </div>


            </div>

        </div>


        <!-- IMAGE -->

        <div class="nil-film nil-film-luxury">

            <img id="nilFrame"
                 src="https://worldcruises.blob.core.windows.net/images/Nil/nile1.jpg"
                 alt="Croisière sur le Nil">

            <div class="nil-image-overlay">

                <span>
                    <i class="bi bi-stars"></i>
                    L'Égypte éternelle
                </span>

            </div>

        </div>

    </div>

</section>



<!-- ===== SECTION 2 ===== -->

<section class="nil-section nil-section-alt">

    <div class="nil-section-content nil-section-reverse">


        <!-- IMAGE -->

        <div class="nil-film2 nil-film-luxury">

            <img id="nilFrame2"
                 src="https://worldcruises.blob.core.windows.net/images/Nil/egypt1.jpg"
                 alt="Égypte">

            <div class="nil-image-overlay">

                <span>
                    <i class="bi bi-stars"></i>
                    Au fil du Nil
                </span>

            </div>

        </div>


        <!-- PROGRAM -->

        <div class="nil-program nil-program-luxury">

            <div class="nil-section-header">

                <div class="nil-header-icon">
                    <i class="bi bi-map"></i>
                </div>

                <div>

                    <span class="nil-subtitle">
                        À LA DÉCOUVERTE DU SUD
                    </span>

                    <h2>
                        Assouan et la Nubie
                    </h2>

                    <p>
                        Les dernières étapes de votre voyage
                    </p>

                </div>

            </div>


            <div class="nil-itinerary-grid">


                <!-- JOUR 4 -->

                <div class="nil-day-card">

                    <div class="nil-day-number">

                        <span>JOUR</span>

                        <strong>4</strong>

                    </div>


                    <div class="nil-day-content">

                        <h3>
                            <i class="bi bi-geo-alt-fill"></i>
                            Kom Ombo → Assouan
                        </h3>

                        <p>
                            <strong>Haut barrage :</strong>
                            Ouvrage moderne majeur, il régule les crues
                            du Nil et alimente l'Égypte en électricité.
                        </p>

                        <p>
                            <strong>Obélisque inachevé.</strong>
                        </p>

                        <p>
                            <strong>Philae :</strong>
                            Dédié à Isis, ce temple sauvé des eaux
                            a été déplacé sur l'île d'Agilkia.
                        </p>

                    </div>

                </div>


                <!-- JOUR 5 -->

                <div class="nil-day-card">

                    <div class="nil-day-number">

                        <span>JOUR</span>

                        <strong>5</strong>

                    </div>


                    <div class="nil-day-content">

                        <h3>
                            <i class="bi bi-geo-alt-fill"></i>
                            Assouan
                        </h3>

                        <p>
                            <strong>Abou Simbel :</strong>
                            Temples monumentaux de Ramsès II et Néfertari,
                            taillés dans la falaise.
                        </p>

                        <p>
                            <strong>Felouque :</strong>
                            Navigation paisible sur le Nil à bord
                            d'un voilier traditionnel.
                        </p>

                        <p>
                            <strong>Village nubien :</strong>
                            Découverte d'un village coloré aux maisons peintes.
                        </p>

                    </div>

                </div>


                <!-- JOUR 6 -->

                <div class="nil-day-card">

                    <div class="nil-day-number">

                        <span>JOUR</span>

                        <strong>6</strong>

                    </div>


                    <div class="nil-day-content">

                        <h3>
                            <i class="bi bi-geo-alt-fill"></i>
                            Débarquement
                        </h3>

                        <p>
                            <strong>Petit-déjeuner.</strong>
                        </p>

                        <p>
                            <strong>Transfert.</strong>
                        </p>

                    </div>

                </div>


            </div>

        </div>


    </div>

</section>

<button id="backToTopBtn" class="back-to-top-btn" onclick="scrollToTop()">↑</button>
<button id="scrollDownBtn" class="scroll-down-btn" onclick="scrollDown()">↓</button>

@code {

    [Inject] ICruiseService CruiseService { get; set; } = default!;

    private string cruiseSlug = "";
    private bool jsInitialized = false;
    private bool isLoadingSlug = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cruise = await CruiseService.GetCruiseByName("Le Nil");
            if (cruise != null)
                cruiseSlug = cruise.Slug;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching cruise data for 'Nil'");
        }
        finally
        {
            isLoadingSlug = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JS.InvokeVoidAsync("startNilFilm");
        await JS.InvokeVoidAsync("startNilFilm2");
        jsInitialized = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!jsInitialized) return;

        try
        {
            await JS.InvokeVoidAsync("stopNilFilm");
            await JS.InvokeVoidAsync("stopNilFilm2");
        }
        catch (JSDisconnectedException)
        {
            // Obwód SignalR już zamknięty (np. odświeżenie strony) — nic do zrobienia
        }
    }
}