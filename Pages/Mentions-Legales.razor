@page "/mentions-legales"

@using LegendaryCruises.Interfaces
@using LegendaryCruises.Services
@using System.Security.Claims
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject ICartService CartService

<nav class="navbar navbar-expand-md navbar-light px-1">

    <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/logo-world-cruises.png" alt="World Cruises Logo" style="height:70px;" />
    </a>



    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse flex-column flex-md-row justify-content-between" id="mainNavbar">
        <div class="d-flex flex-column flex-md-row gap-3 ms-auto align-items-center">

            <AuthorizeView Roles="Admin">
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/cruises-table">
                        CRUISES
                    </a>
                </div>
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/add-cruise">
                        ADD CRUISE
                    </a>
                </div>
            </AuthorizeView>

            <!-- LOGGED IN -->
            <AuthorizeView>
                <Authorized Context="authState">
                    <button class="btn btn-primary rounded-pill px-3 py-1 d-flex align-items-center"
                            @onclick="GoToCart">
                        <i class="bi bi-cart me-2 icon-white"></i>
                        <span>@CartItemCount</span>
                    </button>

                         <span class="me-2 login2" >
                            Bonjour @(authState.User.Identity?.Name ?? authState.User.FindFirst(ClaimTypes.Email)?.Value)
                        </span>

             


                    <a class="btn btn-primary" href="/newcruises">
                        ✨ Nouvelles croisières
                    </a>
                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Logout">
                            LOGOUT
                        </a>
                    </div>

                </Authorized>

                <!-- NOT LOGGED IN -->
                <NotAuthorized>
                    <div class="nav-item px-1">
                        <a class="btn login"
                           href="/Identity/Account/Login?returnUrl=/@Nav.ToBaseRelativePath(Nav.Uri)">
                            LOGIN
                        </a>
                    </div>
                    <div class="nav-item px-1">
                        <a class="custom-buy-btn mt-3" style="text-decoration: none!important" href="/newcruises">
                            ✨ Nouvelles croisières
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    </div>
</nav>

<div class="cruise-details-container">
    <div class="cruise-card">

        <h1 class="cruise-title">Mentions légales</h1>

        <div class="cruise-description">

            <p>
                <strong>1. Éditeur du site</strong><br />
                Le présent site internet est édité par :
            </p>

            <p>
                <strong>Legendary Cruises</strong><br />
                Société spécialisée dans la conception et la réservation de voyages en croisière.<br />
                Siège social : [adresse complète à compléter]<br />
                Téléphone : [numéro à compléter]<br />
                Adresse électronique : [email de contact à compléter]
            </p>

            <p>
                Directeur de la publication : [Nom du responsable à compléter]
            </p>


            <p>
                <strong>2. Activité du site</strong><br />
                Legendary Cruises propose une plateforme permettant aux utilisateurs de
                consulter des offres de croisières, créer un compte client, effectuer des
                réservations et gérer leurs demandes liées aux voyages proposés.
            </p>


            <p>
                <strong>3. Hébergement du site</strong><br />
                Le site est hébergé par un prestataire d’hébergement professionnel assurant
                la disponibilité, la sécurité et la maintenance de l’infrastructure technique.
            </p>

            <p>
                Hébergeur :
                <br />
                Nom de l’hébergeur : [à compléter]
                <br />
                Adresse : [adresse de l’hébergeur]
                <br />
                Site internet : [adresse du prestataire]
            </p>


            <p>
                <strong>4. Accès au site</strong><br />
                Legendary Cruises met tout en œuvre afin de garantir un accès continu au site.
