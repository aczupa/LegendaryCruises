            </p>


            <p>
                <strong>10. Droit applicable</strong><br />
                Les présentes mentions légales sont régies par le droit français.
            </p>

            <p>
                En cas de litige relatif à l’utilisation du site, les parties rechercheront
                en priorité une solution amiable avant toute procédure judiciaire.
            </p>


            <p>
                <strong>11. Contact</strong><br />
                Pour toute question concernant le fonctionnement du site, les services proposés
                ou les présentes mentions légales, vous pouvez contacter Legendary Cruises à
                l’adresse suivante :
            </p>

            <p>
                Email : [adresse email à compléter]
            </p>

        </div>

    </div>
</div>

@code {
    private int CartItemCount = 0;
    private bool IsLoggedIn = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();

        var user = authState.User;

        IsLoggedIn = user.Identity?.IsAuthenticated ?? false;


        if (IsLoggedIn)
        {
            var userId =
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value;


            if (!string.IsNullOrEmpty(userId))
            {
                CartItemCount =
                    await CartService.GetCartItemCount(userId);
            }
        }
    }

    private void GoToCart()
    {
        Nav.NavigateTo("/cart");
    }



}