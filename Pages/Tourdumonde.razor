<button id="backToTopBtn" class="back-to-top-btn" onclick="scrollToTop()">
    ↑
</button>

@code {
    [Inject] ICruiseService CruiseService { get; set; } = default!;

    private string cruiseSlug = "";
    private bool isLoadingSlug = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cruise = await CruiseService.GetCruiseByName("Tour du Monde");
            if (cruise != null)
                cruiseSlug = cruise.Slug;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching cruise data for 'Tourdumonde'");
        }
        finally
        {
            isLoadingSlug = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JSRuntime.InvokeVoidAsync("initVideoNavScroll");
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("scrollToHashIfAny");
    }
}