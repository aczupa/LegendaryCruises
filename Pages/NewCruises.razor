@page "/newcruises"

@using LegendaryCruises.Interfaces
@using LegendaryCruises.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject ICruiseService CruiseService
@inject ICartService CartService
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav

<nav class="navbar navbar-expand-md navbar-light px-1">
    <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/logo-world-cruises.png" alt="World Cruises Logo" style="height:70px;" />
    </a>

    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse flex-column flex-md-row justify-content-between" id="mainNavbar">
        <div class="d-flex flex-column flex-md-row gap-3 ms-auto align-items-center">

            <AuthorizeView Roles="Admin">
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/cruises-table">CRUISES</a>
                </div>
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/add-cruise">ADD CRUISE</a>
                </div>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized Context="authState">
                    <button class="btn btn-primary rounded-pill px-3 py-1 d-flex align-items-center"
                            @onclick="GoToCart">
                        <i class="bi bi-cart me-2 icon-white"></i>
                        <span>@CartItemCount</span>
                    </button>

                    <span class="me-2 login2">
                        Bonjour @(authState.User.Identity?.Name ?? authState.User.FindFirst(ClaimTypes.Email)?.Value)
                    </span>

                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Logout">LOGOUT</a>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <div class="nav-item px-1">
                        <a class="btn login"
                           href="/Identity/Account/Login?returnUrl=/@Nav.ToBaseRelativePath(Nav.Uri)">
                            LOGIN
                        </a>
                    </div>
                    <div class="nav-item px-1">
                        <a class="custom-buy-btn mt-3" style="text-decoration:none!important" href="/newcruises">
                            ✨ Nouvelles croisières
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    </div>
</nav>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-light text-uppercase" style="color:#072d4f;">
            Nouvelles croisières
        </h1>

        <p class="lead text-muted">
            Découvrez nos toutes dernières croisières de luxe et laissez-vous inspirer par des destinations d'exception à travers le monde.
        </p>
    </div>

    @if (cruises == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Chargement des croisières...</p>
        </div>
    }
    else if (!cruises.Any())
    {
        <div class="alert alert-info text-center">
            Aucune nouvelle croisière n'est disponible pour le moment.
        </div>
    }
    else
    {
        <div class="new-cruise-list">

            @foreach (var cruise in cruises)
            {
                var firstDate = cruise.CruiseDates?
                .OrderBy(x => x.DepartureDate)
                .FirstOrDefault();

                <div class="new-cruise-item">

                    <div class="card new-cruise-card">

                        <img src="@cruise.ImageUrl"
                             class="new-cruise-img"
                             alt="@cruise.Title" />

                        <div class="card-body d-flex flex-column">

                            <h4 class="new-cruise-title mb-3">@cruise.Title</h4>

                            <p class="text-muted mb-3">@cruise.Description</p>

                            @if (cruise.Itinerary != null && cruise.Itinerary.Any())
                            {
                                <div class="mb-3">
                                    <strong>Itinéraire</strong>
                                    <ul class="mt-2">
                                        @foreach (var day in cruise.Itinerary.OrderBy(d => d.DayNumber))
                                        {
                                            <li>
                                                <strong>Jour @day.DayNumber :</strong>
                                                @day.Location<br />
                                                <span class="text-muted">@day.Description</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }

                            <hr />

                            <div class="mb-2">
                                <strong>Destination</strong><br />
                                @cruise.Destination
                            </div>

                            @if (!string.IsNullOrWhiteSpace(cruise.DeparturePort))
                            {
                                <div class="mb-2">
                                    <strong>Port de départ</strong><br />
                                    @cruise.DeparturePort
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(cruise.ArrivalPort))
                            {
                                <div class="mb-2">
                                    <strong>Port d'arrivée</strong><br />
                                    @cruise.ArrivalPort
                                </div>
                            }

                            @if (firstDate != null)
                            {
                                <div class="mb-2">
                                    <strong>Premier départ</strong><br />
                                    @firstDate.DepartureDate.ToString("dd MMM yyyy")
                                </div>

                                <div class="mb-2">
                                    <strong>Durée</strong><br />
                                    @firstDate.DurationDays jours
                                </div>
                            }

                            <div class="mb-3">
                                <strong>Départs disponibles</strong><br />
                                @(cruise.CruiseDates?.Count ?? 0)
                            </div>

                            <div class="mt-auto">
                                <button class="btn btn-primary new-cruise-btn"
                                        @onclick="() => OpenCruise(cruise.Slug)">
                                    Réserver votre cabine
                                </button>
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@code {
    private List<Cruise>? cruises;
    private int CartItemCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var result = await CruiseService.GetNewCruises();
        cruises = result.Cruises;

        var authState = await Auth.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                CartItemCount = await CartService.GetCartItemCount(userId);
            }
        }
    }

    private void GoToCart()
    {
        Nav.NavigateTo("/cart");
    }

    private void OpenCruise(string slug)
    {
        Nav.NavigateTo($"/cruises/{slug}");
    }
}
