@using LegendaryCruises.Interfaces
@using LegendaryCruises.Services
@using System.Security.Claims
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject ICartService CartService

@page "/conditions-generales"

<nav class="navbar navbar-expand-md navbar-light px-1">

    <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/logo-world-cruises.png" alt="World Cruises Logo" style="height:70px;" />
    </a>



    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse flex-column flex-md-row justify-content-between" id="mainNavbar">
        <div class="d-flex flex-column flex-md-row gap-3 ms-auto align-items-center">

            <AuthorizeView Roles="Admin">
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/cruises-table">
                        CRUISES
                    </a>
                </div>
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/add-cruise">
                        ADD CRUISE
                    </a>
                </div>
            </AuthorizeView>

            <!-- LOGGED IN -->
            <AuthorizeView>
                <Authorized Context="authState">
                    <button class="btn btn-primary rounded-pill px-3 py-1 d-flex align-items-center"
                            @onclick="GoToCart">
                        <i class="bi bi-cart me-2 icon-white"></i>
                        <span>@CartItemCount</span>
                    </button>


                    <span class="me-2 login2">
                            Bonjour @(authState.User.Identity?.Name ?? authState.User.FindFirst(ClaimTypes.Email)?.Value)
                        </span>



                    <a class="btn btn-primary" href="/newcruises">
                        ✨ Nouvelles croisières
                    </a>
                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Logout">
                            LOGOUT
                        </a>
                    </div>

                </Authorized>

                <!-- NOT LOGGED IN -->
                <NotAuthorized>
                    <div class="nav-item px-1">
                        <a class="btn login"
                           href="/Identity/Account/Login?returnUrl=/@Nav.ToBaseRelativePath(Nav.Uri)">
                            LOGIN
                        </a>
                    </div>
                    <div class="nav-item px-1">
                        <a class="custom-buy-btn mt-3" style="text-decoration: none!important" href="/newcruises">
                            ✨ Nouvelles croisières
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    </div>
</nav>

<div class="cruise-details-container">
    <div class="cruise-card">

        <h1 class="cruise-title">Conditions générales</h1>

        <div class="cruise-description">

            <p>
                <strong>1. Objet des conditions générales</strong><br />
                Les présentes Conditions Générales de Vente (CGV) ont pour objet de définir
                les droits et obligations de Legendary Cruises et de ses clients dans le cadre
                de la vente de prestations de croisières proposées sur le site internet.
            </p>

            <p>
                Toute réservation effectuée sur le site implique l’acceptation pleine et entière
                des présentes conditions générales par le client.
            </p>


            <p>
                <strong>2. Présentation des offres</strong><br />
                Legendary Cruises propose à la réservation des voyages en croisière comprenant
                différentes prestations pouvant inclure selon l’offre :
            </p>

            <ul>
                <li>L’hébergement à bord du navire ;</li>
                <li>L’accès aux espaces et services inclus dans la formule choisie ;</li>
                <li>Les escales et itinéraires indiqués dans le descriptif de la croisière ;</li>
                <li>Les prestations complémentaires éventuellement sélectionnées par le client.</li>
            </ul>

            <p>
                Les photographies, illustrations et descriptions présentes sur le site ont pour
                objectif de présenter les voyages proposés. De légères modifications peuvent
                intervenir selon les contraintes d’exploitation du navire ou des ports d’escale.
            </p>


            <p>
                <strong>3. Création d’un compte client</strong><br />
                La création d’un compte personnel peut être nécessaire afin d’effectuer une
                réservation et de suivre son dossier voyage.
            </p>

            <p>
                Le client s’engage à fournir des informations exactes, complètes et actualisées.
                Il est responsable de la confidentialité de ses identifiants de connexion.
            </p>


            <p>
                <strong>4. Processus de réservation</strong><br />
                Toute réservation effectuée sur le site constitue une demande ferme de prestation.
                La réservation est considérée comme définitive après :
            </p>

            <ul>
                <li>La sélection de la croisière et des options choisies ;</li>
                <li>La validation des informations personnelles ;</li>
                <li>L’acceptation des présentes Conditions Générales de Vente ;</li>
                <li>La confirmation du paiement.</li>
            </ul>

            <p>
                Un email de confirmation est ensuite envoyé au client avec les informations
                relatives à sa réservation.
            </p>


            <p>
                <strong>5. Prix et conditions de paiement</strong><br />
                Les prix affichés sur le site sont indiqués en euros (€), toutes taxes comprises
                lorsque cela est applicable.
            </p>

            <p>
                Le prix final correspond au tarif indiqué au moment de la validation de la
                réservation. Il peut varier selon la période, la disponibilité des cabines,
                les options choisies ou les éventuelles promotions en cours.
            </p>

            <p>
                Le règlement peut être effectué par les moyens de paiement proposés sur le site.
                La réservation devient effective uniquement après validation du paiement.
            </p>


            <p>
                <strong>6. Documents nécessaires au voyage</strong><br />
                Le client est responsable de disposer des documents nécessaires à son voyage :
                pièce d’identité valide, passeport, visas ou autorisations administratives
                éventuellement requis selon les destinations.
            </p>

            <p>
                Legendary Cruises ne pourra être tenue responsable du refus d’embarquement
                résultant de documents manquants ou non conformes.
            </p>


            <p>
                <strong>7. Modification ou annulation par le client</strong><br />
                Toute demande de modification ou d’annulation doit être adressée à Legendary
                Cruises selon les modalités indiquées dans le dossier de réservation.
            </p>

            <p>
                Les frais éventuels d’annulation ou de modification dépendent des conditions
                spécifiques applicables à chaque croisière et peuvent varier selon la date
                de départ et le délai restant avant l’embarquement.
            </p>


            <p>
                <strong>8. Modification ou annulation par Legendary Cruises</strong><br />
                En cas de circonstances exceptionnelles, contraintes techniques, conditions
                météorologiques, décisions des autorités portuaires ou événements indépendants
                de sa volonté, Legendary Cruises pourra être amenée à modifier certains éléments
                du voyage.
            </p>

            <p>
                Dans ce cas, le client sera informé dans les meilleurs délais et des solutions
                adaptées pourront être proposées selon la situation.
            </p>


            <p>
                <strong>9. Responsabilité</strong><br />
                Legendary Cruises s’engage à fournir les prestations décrites dans les offres
                disponibles sur son site.
            </p>

            <p>
                Sa responsabilité ne pourra toutefois être engagée en cas d’événements
                indépendants de sa volonté tels que catastrophes naturelles, conflits,
                décisions administratives, mouvements sociaux ou autres cas de force majeure.
            </p>


            <p>
                <strong>10. Réclamations</strong><br />
                Toute réclamation concernant une réservation ou une prestation doit être
                adressée à Legendary Cruises dans les meilleurs délais après la réalisation
                du voyage.
            </p>

            <p>
                Le client doit fournir toutes les informations nécessaires permettant l’étude
                de sa demande.
            </p>


            <p>
                <strong>11. Données personnelles</strong><br />
                Les informations collectées lors d’une réservation sont utilisées uniquement
                pour la gestion du voyage, le suivi client et les obligations administratives.
            </p>

            <p>
                Pour plus d’informations concernant l’utilisation de vos données personnelles,
                veuillez consulter notre
                <a href="/politique-confidentialite">
                    Politique de confidentialité
                </a>.
            </p>


            <p>
                <strong>12. Droit applicable et règlement des litiges</strong><br />
                Les présentes Conditions Générales de Vente sont soumises au droit français.
            </p>

            <p>
                En cas de litige, le client est invité à rechercher une solution amiable avec
                Legendary Cruises avant toute procédure judiciaire.
            </p>


            <p>
                <strong>13. Acceptation des conditions générales</strong><br />
                La validation d’une réservation implique que le client reconnaît avoir pris
                connaissance des présentes Conditions Générales de Vente et les accepter sans
                réserve.
            </p>

        </div>


    </div>
</div>

@code {
    private int CartItemCount = 0;
    private bool IsLoggedIn = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();

        var user = authState.User;

        IsLoggedIn = user.Identity?.IsAuthenticated ?? false;


        if (IsLoggedIn)
        {
            var userId =
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value;


            if (!string.IsNullOrEmpty(userId))
            {
                CartItemCount =
                    await CartService.GetCartItemCount(userId);
            }
        }
    }

    private void GoToCart()
    {
        Nav.NavigateTo("/cart");
    }



}