@page "/cruises/{Slug}"
@using LegendaryCruises.Interfaces
@using LegendaryCruises.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject ProtectedSessionStorage SessionStorage
@inject ICartService CartService
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav

<nav class="navbar navbar-expand-md navbar-light px-1">

    <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/logo-world-cruises.png" alt="World Cruises Logo" style="height:70px;" />
    </a>

    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse flex-column flex-md-row justify-content-between" id="mainNavbar">
        <div class="d-flex flex-column flex-md-row gap-3 ms-auto align-items-center">

            <AuthorizeView Roles="Admin, Recruiter">
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/cruises-table">
                        CRUISES
                    </a>
                </div>
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/add-cruise">
                        ADD CRUISE
                    </a>
                </div>
            </AuthorizeView>

            <!-- LOGGED IN -->
            <AuthorizeView>
                <Authorized Context="authState">
                    <button class="btn btn-primary rounded-pill px-3 py-1 d-flex align-items-center"
                            @onclick="GoToCart">
                        <i class="bi bi-cart me-2 icon-white"></i>
                        <span>@CartItemCount</span>
                    </button>

                    <span class="me-2 login2">
                        Bonjour @(authState.User.Identity?.Name ?? authState.User.FindFirst(ClaimTypes.Email)?.Value)
                    </span>

                    <a class="btn btn-primary" href="/newcruises">
                        ✨ Nouvelles croisières
                    </a>
                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Logout">
                            LOGOUT
                        </a>
                    </div>

                </Authorized>

                <!-- NOT LOGGED IN -->
                <NotAuthorized>
                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Login">
                            LOGIN
                        </a>
                    </div>
                    <div class="nav-item px-1">
                        <a class="custom-buy-btn mt-3" style="text-decoration: none!important" href="/newcruises">
                            ✨ Nouvelles croisières
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    </div>
</nav>

<div class="cruise-details-container animate-fadeInUp">

    @if (cruise == null)
    {
        <p>Chargement...</p>
    }
    else
    {
        <div class="cruise-card">

            <h1 class="cruise-title">@cruise.Title</h1>

            <div class="cruise-meta">
                <p><strong>Destination :</strong> @cruise.Destination</p>
                <p><strong>Port de départ :</strong> @cruise.DeparturePort</p>
            </div>

            <div class="cruise-description">
                @cruise.Description
            </div>

            <!-- BOOKING -->
            <div class="booking-section">

                <!-- DATE SELECT -->
                <div class="booking-block">
                    <label>Choisissez votre date de départ</label>

                    <select class="form-control" @onchange="OnDateChanged">
                        <option value="">-- choisissez une date --</option>

                        @foreach (var date in cruise.CruiseDates)
                        {
                            <option value="@date.Id">
                                @date.DepartureDate.ToString("dd MMM yyyy")
                                -
                                @date.ReturnDate.ToString("dd MMM yyyy")
                            </option>
                        }
                    </select>
                </div>

                <!-- CABINS -->
                <div class="booking-block">
                    <label>Choisissez votre cabine</label>

                    @if (selectedCruiseDate == null)
                    {
                        <p>A très vite!</p>
                    }
                    else
                    {
                        @foreach (var cabin in selectedCruiseDate.Cabins)
                        {
                            <div class="cabin-row">
                                <div class="cabin-info">
                                    <span>@cabin.CabinType</span>
                                    <span class="cabin-price">@cabin.Price @cruise.Currency</span>
                                    <span>Disponible: @cabin.Available</span>
                                </div>

                                <input type="number"
                                       min="0"
                                       max="@cabin.Available"
                                       class="form-control cabin-qty"
                                       @bind="cabinSelections[cabin.Id]" />
                            </div>
                        }
                    }
                </div>

                <!-- TOTAL -->
                <div class="booking-total">
                    Total: @CalculateTotal() @cruise.Currency
                </div>

                <!-- ERROR MESSAGE -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-warning mt-3" role="alert">
                        @errorMessage
                    </div>
                }
                <!-- SUCCESS MESSAGE -->
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success mt-3" role="alert">
                        @successMessage
                    </div>
                }

               
                <button class="custom-buy-btn mt-3" @onclick="AddToCart">
                    Réserver maintenant
                </button>

            </div>
        </div>
    }
</div>

<!-- ===================== GALLERY ===================== -->

