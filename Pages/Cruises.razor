@code {

    [Inject] public ICruiseService CruiseService { get; set; } = default!;

    [Parameter] public string Slug { get; set; } = string.Empty;

    private Cruise? cruise;

    private CruiseDate? selectedCruiseDate;
    private Dictionary<int, int> cabinSelections = new();

    private bool IsLoggedIn = false;
    private int CartItemCount = 0;

    private bool cartRestored = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();

        var user = authState.User;

        IsLoggedIn = user.Identity?.IsAuthenticated ?? false;

        if (IsLoggedIn)
        {
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                CartItemCount = await CartService.GetCartItemCount(userId);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        cruise = await CruiseService.GetCruiseBySlug(Slug);
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        errorMessage = null;
        if (!int.TryParse(e.Value?.ToString(), out int id))
            return;

        selectedCruiseDate = cruise?.CruiseDates.FirstOrDefault(d => d.Id == id);

        if (selectedCruiseDate != null)
        {
            cabinSelections = selectedCruiseDate.Cabins
                .ToDictionary(c => c.Id, c => 0);
        }
    }

    private decimal CalculateTotal()
    {
        if (selectedCruiseDate == null) return 0;

        return selectedCruiseDate.Cabins.Sum(c =>
            cabinSelections.TryGetValue(c.Id, out int qty) ? c.Price * qty : 0);
    }

    private async Task AddToCart()
    {
        if (selectedCruiseDate == null)
        {
            errorMessage = "Vous devez choisir la date et la cabine avant de réserver";
            return;
        }

        var selectedCabins = cabinSelections
            .Where(x => x.Value > 0)
            .ToDictionary(
                x => x.Key,
                x => x.Value);

        if (!selectedCabins.Any())
        {
            errorMessage = "Vous devez choisir votre cabine avant de réserver la croisière";
            return;
        }

        errorMessage = null;
        var authState = await Auth.GetAuthenticationStateAsync();

        var user = authState.User;

        if (!(user.Identity?.IsAuthenticated ?? false))
        {
            var pending = new PendingCart
            {
                Slug = Slug,
                CruiseId = cruise!.Id,
                CruiseDateId = selectedCruiseDate.Id,
                Cabins = selectedCabins
            };

            await SessionStorage.SetAsync(
                "PendingCart",
                pending);

            Nav.NavigateTo(
                $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString($"/cruises/{Slug}")}&message=login-required",
                true);

            return;
        }

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        foreach (var cabin in selectedCabins)
        {
            await CartService.AddToCart(
                userId!,
                cruise!.Id,
                selectedCruiseDate.Id,
                cabin.Key,
                cabin.Value);
        }

        Nav.NavigateTo("/cart");
    }

    private void GoToCart()
    {
        Nav.NavigateTo("/cart");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!cartRestored)
        {
            cartRestored = true;

            var authState = await Auth.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                var pending = await SessionStorage.GetAsync<PendingCart>("PendingCart");

                if (pending.Success && pending.Value != null)
                {
                    foreach (var cabin in pending.Value.Cabins)
                    {
                        await CartService.AddToCart(
                            userId!,
                            pending.Value.CruiseId,
                            pending.Value.CruiseDateId,
                            cabin.Key,
                            cabin.Value);
                    }

                    await SessionStorage.DeleteAsync("PendingCart");
                    if (string.IsNullOrEmpty(userId))
                    {
                        return;
                    }

                    CartItemCount = await CartService.GetCartItemCount(userId);
                    successMessage = "Votre croisière a été ajoutée au panier !";
                    StateHasChanged();
                }
            }
        }
    }
}