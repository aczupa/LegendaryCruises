@page "/ilesgrecques"
@using LegendaryCruises.Components
@using LegendaryCruises.Interfaces
@using System.Security.Claims
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject ICruiseService CruiseService
@inject ILogger<Ilesgrecques> Logger

<PageTitle>World Cruises - Îles Grecques</PageTitle>

<nav class="navbar navbar-expand-md navbar-light px-1" style="background-color: rgba(255,255,255,0.25); backdrop-filter: blur(8px);">

    <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="https://worldcruises.blob.core.windows.net/images/logo-world-cruises.png"
             alt="World Cruises Logo" style="height:70px;" />
    </a>
    <h3>Îles Grecques</h3>

    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse flex-column flex-md-row justify-content-between" id="mainNavbar">
        <div class="d-flex flex-column flex-md-row gap-3 ms-auto align-items-center">

            <AuthorizeView Roles="Admin">
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/cruises-table">CRUISES</a>
                </div>
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/add-cruise">ADD CRUISE</a>
                </div>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized Context="authState">
                    <span class="me-2 login2">
                        Bonjour @(authState.User.Identity?.Name ?? authState.User.FindFirst(ClaimTypes.Email)?.Value)
                    </span>

                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Logout">LOGOUT</a>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <div class="nav-item px-1">
                        <a class="btn login"
                           href="/Identity/Account/Login?returnUrl=/@Nav.ToBaseRelativePath(Nav.Uri)">
                            LOGIN
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            <ButtonBuy Slug="@cruiseSlug" IsLoading="@isLoadingSlug" />

        </div>
    </div>
</nav>

<div class="video-container">
    <video autoplay muted loop playsinline id="bg-video">
        <source src="https://worldcruises.blob.core.windows.net/videos/Bienvenue.mp4" type="video/mp4">
    </video>
    <div id="video-overlay"></div>
</div>

<div class="video-nav-bar">
    <a class="video-nav-link" href="#athenes">Athènes</a>
    <a class="video-nav-link" href="#mykonos">Mykonos</a>
    <a class="video-nav-link" href="#santorin">Santorini</a>
    <a class="video-nav-link" href="#crete">Crète</a>
    <a class="video-nav-link" href="#rhodes">Rhodes</a>
    <a class="video-nav-link" href="#patmos">Patmos</a>
    <a class="video-nav-link" href="#kusadasi">Kusadasi</a>
    <a class="video-nav-link" href="#mer">Mer Égée</a>
    <a class="video-nav-link" href="#fin">Athènes</a>
</div>

<div class="row gy-4 mt-2">

    <!-- Athènes -->
    <div class="col-md-4 animate-fadeInUp" id="athenes" style="animation-delay: 1.1s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/athenes.jpg"
                 class="card-img-top fixed-img" alt="Athènes" />
            <div class="card-body text-center">
                <h5 class="card-title">Arrivée à Athènes</h5>
                <p class="card-text">
                    Embarquement au port du Pirée en début d’après-midi.
                    Vue sur l’Acropole depuis la mer.
                    Cocktail de bienvenue à bord.
                    Départ au coucher du soleil.
                    🌅 Première nuit en mer Égée.
                </p>
            </div>
        </div>
    </div>

    <!-- Mykonos -->
    <div class="col-md-4 animate-fadeInUp" id="mykonos" style="animation-delay: 1.3s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/mykonos.jpg"
                 class="card-img-top fixed-img" alt="Mykonos" />
            <div class="card-body text-center">
                <h5 class="card-title">Mykonos</h5>
                <p class="card-text">
                    Île mythique, vibrante et élégante.
                    Little Venice, moulins à vent, plages dorées.
                    🌙 Escale tardive pour profiter de l’ambiance nocturne.
                </p>
            </div>
        </div>
    </div>

    <!-- Santorini -->
    <div class="col-md-4 animate-fadeInUp" id="santorin" style="animation-delay: 1.5s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/santorini2.jpg"
                 class="card-img-top fixed-img" alt="Santorini" />
            <div class="card-body text-center">
                <h5 class="card-title">Santorini</h5>
                <p class="card-text">
                    Falaises volcaniques, villages d’Oia et Fira,
                    dômes bleus, maisons blanches.
                    🌋 Un des plus beaux couchers de soleil au monde.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row gy-4 mt-2">

    <!-- Crète -->
    <div class="col-md-4 animate-fadeInUp" id="crete" style="animation-delay: 1.7s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/crète.jpg"
                 class="card-img-top fixed-img" alt="Crète" />
            <div class="card-body text-center">
                <h5 class="card-title">Crète</h5>
                <p class="card-text">
                    Palais de Knossos, vieille ville d’Héraklion,
                    saveurs crétoises traditionnelles.
                    🏺 Histoire et gastronomie.
                </p>
            </div>
        </div>
    </div>

    <!-- Rhodes -->
    <div class="col-md-4 animate-fadeInUp" id="rhodes" style="animation-delay: 1.9s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/rhodes.jpg"
                 class="card-img-top fixed-img" alt="Rhodes" />
            <div class="card-body text-center">
                <h5 class="card-title">Rhodes</h5>
                <p class="card-text">
                    Vieille ville médiévale (UNESCO),
                    Palais du Grand Maître,
                    Port de Mandraki.
                    ⚔️ Mélange unique d’Orient et d’Occident.
                </p>
            </div>
        </div>
    </div>

    <!-- Patmos -->
    <div class="col-md-4 animate-fadeInUp" id="patmos" style="animation-delay: 2.1s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/patmos.jpg"
                 class="card-img-top fixed-img" alt="Patmos" />
            <div class="card-body text-center">
                <h5 class="card-title">Patmos</h5>
                <p class="card-text">
                    Monastère de Saint-Jean,
                    Grotte de l’Apocalypse,
                    Chora aux ruelles blanches.
                    ⛪ Atmosphère contemplative et hors du temps.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row gy-4 mt-2">

    <!-- Kusadasi -->
    <div class="col-md-4 animate-fadeInUp" id="kusadasi" style="animation-delay: 0.5s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/paros.jpg"
                 class="card-img-top fixed-img" alt="Kusadasi" />
            <div class="card-body text-center">
                <h5 class="card-title">Kusadasi</h5>
                <p class="card-text">
                    Site antique d’Éphèse,
                    Bibliothèque de Celsus,
                    Grand théâtre.
                    🏛️ Une cité antique exceptionnelle.
                </p>
            </div>
        </div>
    </div>

    <!-- Mer Égée -->
    <div class="col-md-4 animate-fadeInUp" id="mer" style="animation-delay: 0.9s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/mykonos2.jpg"
                 class="card-img-top fixed-img" alt="Mer Égée" />
            <div class="card-body text-center">
                <h5 class="card-title">Mer Égée</h5>
                <p class="card-text">
                    Piscine & spa,
                    conférences culturelles,
                    cuisine méditerranéenne raffinée.
                    🌊 Repos face à la mer infinie.
                </p>
            </div>
        </div>
    </div>

    <!-- Athènes (fin) -->
    <div class="col-md-4 animate-fadeInUp" style="animation-delay: 0.7s;">
        <div class="card shadow-sm h-100">
            <img src="https://worldcruises.blob.core.windows.net/images/Greece/athens.jpg"
                 class="card-img-top fixed-img" id="fin" alt="Athènes" />
            <div class="card-body text-center">
                <h5 class="card-title">Athènes</h5>
                <p class="card-text">
                    Arrivée matinale.
                    Fin de la croisière.
                    Possibilité d’extension à Athènes ou aux Météores.
                </p>
            </div>
        </div>
    </div>
</div>

<button id="backToTopBtn" class="back-to-top-btn" onclick="scrollToTop()">↑</button>

@code {
    private string cruiseSlug = "";
    private bool isLoadingSlug = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cruise = await CruiseService.GetCruiseByName("Îles Grecques");

            if (cruise != null)
            {
                cruiseSlug = cruise.Slug;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching cruise data for Îles Grecques");
        }
        finally
        {
            isLoadingSlug = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JSRuntime.InvokeVoidAsync("initVideoNavScroll");
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("scrollToHashIfAny");
    }
}