@page "/alaska"
@using LegendaryCruises.Components
@using LegendaryCruises.Interfaces
@using System.Security.Claims
@inject ICruiseService CruiseService
@inject NavigationManager Nav
@inject ILogger<Alaska> Logger

<nav class="navbar navbar-expand-md navbar-light px-1">
    <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/logo-world-cruises.png" alt="World Cruises Logo" style="height:70px;" />
    </a>
    <h3>Alaska</h3>
    <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse flex-column flex-md-row justify-content-between" id="mainNavbar">
        <div class="d-flex flex-column flex-md-row gap-3 ms-auto align-items-center">
            <AuthorizeView Roles="Admin">
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/cruises-table">CRUISES</a>
                </div>
                <div class="nav-item px-1">
                    <a class="btn login" href="/admin/add-cruise">ADD CRUISE</a>
                </div>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized Context="authState">
                    <span class="me-2 login2">
                        Bonjour @(authState.User.Identity?.Name ?? authState.User.FindFirst(ClaimTypes.Email)?.Value)
                    </span>
                    <div class="nav-item px-1">
                        <a class="btn login" href="/Identity/Account/Logout">LOGOUT</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-item px-1">
                        <a class="btn login"
                           href="/Identity/Account/Login?returnUrl=/@Nav.ToBaseRelativePath(Nav.Uri)">
                            LOGIN
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
            <ButtonBuy Slug="@cruiseSlug" />
        </div>
    </div>
</nav>

<div class="page">
    <div class="accordion-grid">
        @for (int i = 0; i < videos.Length; i++)
        {
            var index = i;
            <div class="cell" @onclick="() => OpenOverlay(index)">
                <video src="@videos[index]"
                       autoplay muted loop playsinline preload="metadata">
                </video>
            </div>
        }
    </div>
</div>

<div class="overlay @(showOverlay ? "active" : "")" @onclick="CloseOverlay">
    <div class="overlay-content" @onclick:stopPropagation="true">
        <button class="close-btn" @onclick="CloseOverlay">×</button>
        <div>
            <strong>@days[selectedIndex].Title</strong><br /><br />
            @((MarkupString)days[selectedIndex].Content)
        </div>
    </div>
</div>

@code {
    private string cruiseSlug = "";
    private bool showOverlay = false;
    private int selectedIndex = 0;

    private static readonly string BaseUrl = "https://worldcruises.blob.core.windows.net/videos/alaska/";

    private string[] videos = new[]
    {
        $"{BaseUrl}alaska2.mp4",
        $"{BaseUrl}alaska10.mp4",
        $"{BaseUrl}alaska11.mp4",
        $"{BaseUrl}alaska1.mp4",
        $"{BaseUrl}alaska12.mp4",
        $"{BaseUrl}alaska6.mp4",
        $"{BaseUrl}alaska13.mp4",
        $"{BaseUrl}alaska8.mp4",
        $"{BaseUrl}alaska5.mp4",
        $"{BaseUrl}alaska9.mp4"
    };

    private record DayInfo(string Title, string Content);

    private List<DayInfo> days = new()
    {
        new("Jour 1 – Embarquement & départ",
            "Accueil au port et embarquement à bord du navire.<br>Installation en cabine, premières découvertes du bateau.<br><br>Le voyage commence, cap vers les terres sauvages de l'Alaska."),
        new("Jour 2 – Navigation en mer",
            "Journée de navigation le long du Pacifique Nord.<br>Conférences, observation des oiseaux marins et détente à bord.<br><br>L'horizon s'élargit, le rythme ralentit."),
        new("Jour 3 – Fjords & Inside Passage",
            "Entrée dans l'Inside Passage, l'une des plus belles routes maritimes du monde.<br>Montagnes abruptes, forêts profondes et eaux calmes.<br><br>Une navigation spectaculaire et silencieuse."),
        new("Jour 4 – Glaciers majestueux",
            "Approche des grands glaciers d'Alaska.<br>La glace millénaire se fracture et glisse lentement vers la mer.<br><br>Un moment de pure contemplation."),
        new("Jour 5 – Faune sauvage",
            "Observation des baleines, orques, phoques et aigles.<br>Chaque apparition est un privilège rare et fugace.<br><br>La nature règne en maître."),
        new("Jour 6 – Escale en Alaska",
            "Escale dans une ville emblématique (Juneau, Skagway ou Ketchikan).<br>Découverte de l'histoire locale et des cultures autochtones.<br><br>Entre civilisation et immensité sauvage."),
        new("Jour 7 – Forêts boréales & montagnes",
            "Navigation le long de vastes étendues forestières.<br>Brume légère, sommets enneigés, silence profond.<br><br>Le temps semble suspendu."),
        new("Jour 8 – Navigation polaire",
            "Le navire progresse entre glace, mer et ciel changeant.<br>Observation des paysages depuis le pont ou le salon panoramique.<br><br>Une expérience hors du monde."),
        new("Jour 9 – Ciel du Nord & derniers glaciers",
            "Derniers panoramas glacés avant le retour.<br>Selon les conditions, observation du ciel boréal.<br><br>Un final tout en émotion."),
        new("Jour 10 – Retour & débarquement",
            "Arrivée au port et débarquement.<br>Fin de la croisière après un voyage hors du temps.<br><br>L'Alaska laisse une empreinte durable.")
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cruise = await CruiseService.GetCruiseByName("Alaska");
            if (cruise != null)
                cruiseSlug = cruise.Slug;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas pobierania rejsu dla Alaski");
        }
    }
    private void OpenOverlay(int index)
    {
        selectedIndex = index;
        showOverlay = true;
    }

    private void CloseOverlay()
    {
        showOverlay = false;
    }
}